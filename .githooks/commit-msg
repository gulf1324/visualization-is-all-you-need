#!/bin/sh
# Enforce Conventional Commits. Wired via: git config core.hooksPath .githooks
set -e

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# First non-comment, non-empty line is the subject.
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | sed -n '1p')

# Allow merge/revert/fixup machinery to pass through untouched.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if printf '%s' "$subject" | grep -Eq "$pattern"; then
  if [ "${#subject}" -gt 72 ]; then
    echo "commit-msg: subject is ${#subject} chars; keep it <= 72." >&2
    exit 1
  fi
  case "$subject" in
    *.) echo "commit-msg: drop the trailing period in the subject." >&2; exit 1 ;;
  esac
  exit 0
fi

cat >&2 <<'EOF'
commit-msg: rejected - subject must follow Conventional Commits.

  <type>(<optional scope>)!: <subject>

  type: feat fix docs style refactor perf test build ci chore revert
  e.g.  feat(parser): support nested diagram nodes
        fix!: drop legacy layout field

  SemVer: fix -> PATCH, feat -> MINOR, `!`/BREAKING CHANGE -> MAJOR
EOF
exit 1
